meta {
  name: Record payment (deposit)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/bookings/{{paymentBookingId}}/payments
  body: json
  auth: none
}

body:json {
  {"reference":"{{paymentRef}}","amountCents":10000,"paidAt":"2030-01-01T09:00:00.000Z"}
}

assert {
  res.status: eq 201
  res.body.paymentId: isString
}

script:post-response {
  bru.setVar("paymentId", res.body.paymentId);
}
