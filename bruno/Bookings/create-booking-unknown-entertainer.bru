meta {
  name: Create booking - unknown entertainer (404)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/bookings
  body: json
  auth: none
}

body:json {
  {
    "venueId": "{{venueId}}",
    "entertainerId": "nobody",
    "feeCents": 45000,
    "startsAt": "2030-01-10T20:00:00.000Z"
  }
}

assert {
  res.status: eq 404
  res.body.errors.entertainerId: isString
}
